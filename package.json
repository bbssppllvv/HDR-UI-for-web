  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bbssppllvv/HDR-UI-for-web.git"
  },
  "homepage": "https://github.com/bbssppllvv/HDR-UI-for-web#readme",
  "bugs": {
    "url": "https://github.com/bbssppllvv/HDR-UI-for-web/issues"
  },
  "style": "./index.css",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
